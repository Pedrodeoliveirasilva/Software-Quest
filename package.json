{
  "name": "software-quest",
  "version": "1.0.0",
  "description": "Software Quest: Missão Entrega Contínua — jogo educacional sobre processos de desenvolvimento de software",
  "private": true,
  "scripts": {
    "start": "node servidor.js",
    "dev": "node --watch servidor.js",
    "test": "node --test test/*.test.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  },
  "license": "UNLICENSED"
}
